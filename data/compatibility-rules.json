      "wpforms/wpforms.php": {
        "delay_exclusions": [
          "wpforms/assets/js",
          "wpforms_settings",
          "wpforms"
        ],
        "settings_issues": [
          {
            "key": "js_delay",
            "severity": "info",
            "code": "wpforms_delay_guard",
            "message": "WPForms scripts are protected from delayed JavaScript so forms remain interactive on first load.",
            "when": {
              "setting": "js_delay",
              "value": true
            }
          }
        ]
      },
      "complianz-gdpr/complianz-gdpr.php": {
        "delay_exclusions": [
          "complianz",
          "cmplz-",
          "cookieblocker"
        ],
        "settings_issues": [
          {
            "key": "js_delay",
            "severity": "info",
            "code": "consent_delay_guard",
            "message": "Consent scripts are protected from delayed JavaScript so consent controls are available immediately.",
            "when": {
              "setting": "js_delay",
              "value": true
            }
          }
        ]
      },
      "cookiebot/cookiebot.php": {
        "delay_exclusions": [
          "cookiebot",
          "uc.js",
          "Cookiebot"
        ],
        "settings_issues": [
          {
            "key": "js_delay",
            "severity": "info",
            "code": "consent_delay_guard",
            "message": "Consent scripts are protected from delayed JavaScript so consent controls are available immediately.",
            "when": {
              "setting": "js_delay",

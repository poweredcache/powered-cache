        ],
        "settings_issues": [
          {
            "key": "js_delay",
            "severity": "info",
            "code": "ninja_forms_delay_guard",
            "message": "Ninja Forms scripts are protected from delayed JavaScript so form validation remains responsive.",
            "when": {
              "setting": "js_delay",
              "value": true
            }
          }
        ]
      },
      "wpforms-lite/wpforms.php": {
        "delay_exclusions": [
          "wpforms/assets/js",
          "wpforms_settings",
          "wpforms"
        ],
        "settings_issues": [
          {
            "key": "js_delay",
            "severity": "info",
            "code": "wpforms_delay_guard",
            "message": "WPForms scripts are protected from delayed JavaScript so forms remain interactive on first load.",
            "when": {
              "setting": "js_delay",

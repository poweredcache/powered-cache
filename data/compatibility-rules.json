{
  "format": "powered-cache-compatibility-rules",
  "format_version": "1.0",
  "rules": {
    "defer_exclusions": [],
    "delay_exclusions": [
      "wp-includes/js/dist/interactivity.min.js",
      "wp-includes/blocks/image/view.min.js",
      "www.google.com/recaptcha",
      "www.gstatic.com/recaptcha",
      "grecaptcha",
      "challenges.cloudflare.com/turnstile",
      "cf-turnstile",
      "hcaptcha.com/1/api.js",
      "hcaptcha",
      "js.stripe.com",
      "paypal.com/sdk/js",
      "pay.google.com/gp/p/js/pay",
      "x.klarnacdn.net/kp/lib",
      "static-eu.payments-amazon.com/checkout",
      "accounts.google.com/gsi/client",
      "appleid.cdn-apple.com",
      "maps.googleapis.com/maps/api/js",
      "maps.google.com/maps-api-v3"
    ],
    "file_optimizer_css_exclusions": [],
    "file_optimizer_js_exclusions": [],
    "lazy_load_exclusions": [
      "selectors.core.image.lightboxObjectFit",
      "data-no-lazy",
      "skip-lazy",
      "no-lazy",
      "woocommerce-product-gallery__image",
      "wp-post-image"
    ]
  },
  "settings_issues": [
    {
      "key": "js_delay",
      "severity": "info",
      "code": "compatibility_rule_applied",
      "message": "Powered Cache automatically keeps WordPress core interactivity scripts out of delayed JavaScript execution.",
      "when": {
        "setting": "js_delay",
        "value": true
      }
    }
  ],
  "conditional_rules": {
    "environments": {
      "cdn:cloudflare": {
        "delay_exclusions": [
          "cdn-cgi/challenge-platform",
          "/cdn-cgi/challenge-platform/",
          "cf-chl-widget"
        ],
        "settings_issues": [
          {
            "key": "js_delay",
            "severity": "info",
            "code": "cloudflare_challenge_delay_guard",
            "message": "Cloudflare challenge scripts are protected from delayed JavaScript when Cloudflare is detected.",
            "when": {
              "setting": "js_delay",
              "value": true
            }
          }
        ]
      },
      "server:nginx": {
        "settings_issues": [
          {
            "key": "auto_configure_htaccess",
            "severity": "warning",
            "code": "nginx_htaccess_noop",
            "message": "Nginx does not read .htaccess files. Keep this off unless Apache-compatible rewrite handling is also available.",
            "when": {
              "setting": "auto_configure_htaccess",
              "value": true
            }
          }
        ]
      }
    },
    "plugins": {
      "woocommerce/woocommerce.php": {
        "delay_exclusions": [
          "woocommerce/assets/js/frontend/cart-fragments",
          "woocommerce/assets/js/frontend/checkout",
          "woocommerce/assets/js/frontend/add-to-cart",
          "woocommerce/assets/js/frontend/add-to-cart-variation",
          "woocommerce/assets/js/frontend/cart",
          "woocommerce/assets/js/frontend/country-select",
          "woocommerce/assets/js/frontend/address-i18n",
          "woocommerce/assets/js/frontend/password-strength-meter",
          "woocommerce/assets/js/frontend/single-product",
          "wc-cart-fragments",
          "wc-checkout",
          "wc-add-to-cart",
          "wc-cart",
          "wc-country-select",
          "wc-address-i18n",
          "wc-password-strength-meter",
          "wc-single-product"
        ],
        "settings_issues": [
          {
            "key": "js_delay",
            "severity": "info",
            "code": "woocommerce_delay_guard",
            "message": "WooCommerce cart, checkout, and add-to-cart scripts are protected from delayed JavaScript when WooCommerce is active.",
            "when": {
              "setting": "js_delay",
              "value": true
            }
          }
        ]
      },
      "elementor/elementor.php": {
        "delay_exclusions": [
          "elementor/assets/js/frontend",
          "elementorFrontend"
        ],
        "settings_issues": [
          {
            "key": "js_delay",
            "severity": "info",
            "code": "elementor_delay_guard",
            "message": "Elementor frontend scripts are protected from delayed JavaScript to keep widgets responsive.",
            "when": {
              "setting": "js_delay",
              "value": true
            }
          }
        ]
      },
      "elementor-pro/elementor-pro.php": {
        "delay_exclusions": [
          "elementor-pro/assets/js/frontend"
        ],
        "settings_issues": [
          {
            "key": "js_delay",
            "severity": "info",
            "code": "elementor_pro_delay_guard",
            "message": "Elementor Pro frontend scripts are protected from delayed JavaScript when Elementor Pro is active.",
            "when": {
              "setting": "js_delay",
              "value": true
            }
          }
        ]
      },
      "shortpixel-adaptive-images/short-pixel-ai.php": {
        "delay_exclusions": [
          "spai_js"
        ],
        "settings_issues": [
          {
            "key": "js_delay",
            "severity": "info",
            "code": "shortpixel_ai_delay_guard",
            "message": "ShortPixel Adaptive Images is protected from delayed JavaScript when both optimizers are active.",
            "when": {
              "setting": "js_delay",
              "value": true
            }
          }
        ]
      },
      "contact-form-7/wp-contact-form-7.php": {
        "delay_exclusions": [
          "contact-form-7/includes/js",
          "wpcf7",
          "recaptcha"
        ],
        "settings_issues": [
          {
            "key": "js_delay",
            "severity": "info",
            "code": "contact_form_delay_guard",
            "message": "Contact form scripts are protected from delayed JavaScript so validation and anti-spam checks stay responsive.",
            "when": {
              "setting": "js_delay",
              "value": true
            }
          }
        ]
      },
      "gravityforms/gravityforms.php": {
        "delay_exclusions": [
          "gravityforms/js",
          "gform",
          "gform_"
        ],
        "settings_issues": [
          {
            "key": "js_delay",
            "severity": "info",
            "code": "gravity_forms_delay_guard",
            "message": "Gravity Forms scripts are protected from delayed JavaScript so forms remain interactive on first load.",
            "when": {
              "setting": "js_delay",
              "value": true
            }
          }
        ]
      },
      "forminator/forminator.php": {
        "delay_exclusions": [
          "forminator/assets/js",
          "forminatorFront",
          "forminator"
        ],
        "settings_issues": [
          {
            "key": "js_delay",
            "severity": "info",
            "code": "forminator_delay_guard",
            "message": "Forminator scripts are protected from delayed JavaScript so form validation remains responsive.",
            "when": {
              "setting": "js_delay",
              "value": true
            }
          }
        ]
      },
      "fluentform/fluentform.php": {
        "delay_exclusions": [
          "fluentform",
          "fluent-form",
          "ff-el"
        ],
        "settings_issues": [
          {
            "key": "js_delay",
            "severity": "info",

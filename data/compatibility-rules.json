{
  "format": "powered-cache-compatibility-rules",
  "format_version": "1.0",
  "rules": {
    "defer_exclusions": [],
    "delay_exclusions": [
      "wp-includes/js/dist/interactivity.min.js",
      "wp-includes/blocks/image/view.min.js"
    ],
    "file_optimizer_css_exclusions": [],
    "file_optimizer_js_exclusions": [],
    "lazy_load_exclusions": [
      "selectors.core.image.lightboxObjectFit"
    ]
  },
  "settings_issues": [
    {
      "key": "js_delay",
      "severity": "info",
      "code": "compatibility_rule_applied",
      "message": "Powered Cache automatically keeps WordPress core interactivity scripts out of delayed JavaScript execution.",
      "when": {
        "setting": "js_delay",
        "value": true
      }
    }
  ],
  "conditional_rules": {
    "plugins": {
      "woocommerce/woocommerce.php": {
        "delay_exclusions": [
          "woocommerce/assets/js/frontend/cart-fragments",
          "woocommerce/assets/js/frontend/checkout",
          "woocommerce/assets/js/frontend/add-to-cart",
          "woocommerce/assets/js/frontend/add-to-cart-variation",
          "wc-cart-fragments",
          "wc-checkout",
          "wc-add-to-cart"
        ],
        "settings_issues": [
          {
            "key": "js_delay",
            "severity": "info",
            "code": "woocommerce_delay_guard",
            "message": "WooCommerce cart, checkout, and add-to-cart scripts are protected from delayed JavaScript when WooCommerce is active.",
            "when": {
              "setting": "js_delay",
              "value": true
            }
          }
        ]
      },
      "elementor/elementor.php": {
        "delay_exclusions": [
          "elementor/assets/js/frontend",
          "elementorFrontend"
        ],
        "settings_issues": [
          {
            "key": "js_delay",
            "severity": "info",
            "code": "elementor_delay_guard",
            "message": "Elementor frontend scripts are protected from delayed JavaScript to keep widgets responsive.",
            "when": {
              "setting": "js_delay",
              "value": true
            }
          }
        ]
      },
      "elementor-pro/elementor-pro.php": {
        "delay_exclusions": [
          "elementor-pro/assets/js/frontend"
        ],
        "settings_issues": [
          {
            "key": "js_delay",
            "severity": "info",
            "code": "elementor_pro_delay_guard",
            "message": "Elementor Pro frontend scripts are protected from delayed JavaScript when Elementor Pro is active.",
            "when": {
              "setting": "js_delay",
              "value": true
            }
          }
        ]
      },
      "shortpixel-adaptive-images/short-pixel-ai.php": {
        "delay_exclusions": [
          "spai_js"
        ],
        "settings_issues": [
          {
            "key": "js_delay",
            "severity": "info",
            "code": "shortpixel_ai_delay_guard",
            "message": "ShortPixel Adaptive Images is protected from delayed JavaScript when both optimizers are active.",
            "when": {
              "setting": "js_delay",
              "value": true
            }
          }
        ]
      },
      "autoptimize/autoptimize.php": {
        "settings_issues": [
          {
            "key": "minify_html",
            "severity": "warning",
            "code": "autoptimize_html_active",
            "message": "Autoptimize HTML optimization is active. Powered Cache HTML minification may be ignored until Autoptimize HTML optimization is disabled.",
            "when": {
              "setting": "minify_html",
              "value": true,
              "options": [
                {
                  "name": "autoptimize_html",
                  "value": "on"
                }
              ]
            }
          },
          {
            "key": "minify_css",
            "severity": "warning",
            "code": "autoptimize_css_active",
            "message": "Autoptimize CSS optimization is active. Powered Cache CSS minification may be ignored until Autoptimize CSS optimization is disabled.",
            "when": {
              "setting": "minify_css",
              "value": true,
              "options": [
                {
                  "name": "autoptimize_css",
                  "value": "on"
                }
              ]
            }
          },
          {
            "key": "combine_css",
            "severity": "warning",
            "code": "autoptimize_css_active",
            "message": "Autoptimize CSS optimization is active. Powered Cache CSS combining may be ignored until Autoptimize CSS optimization is disabled.",
            "when": {
              "setting": "combine_css",
              "value": true,
              "options": [
                {
                  "name": "autoptimize_css",
                  "value": "on"
                }
              ]
            }
          },
          {
            "key": "minify_js",
            "severity": "warning",
            "code": "autoptimize_js_active",
            "message": "Autoptimize JavaScript optimization is active. Powered Cache JavaScript minification may be ignored until Autoptimize JavaScript optimization is disabled.",
            "when": {
              "setting": "minify_js",
              "value": true,
              "options": [
                {
                  "name": "autoptimize_js",
                  "value": "on"
                }
              ]
            }
          },
          {
            "key": "combine_js",
            "severity": "warning",
            "code": "autoptimize_js_active",
            "message": "Autoptimize JavaScript optimization is active. Powered Cache JavaScript combining may be ignored until Autoptimize JavaScript optimization is disabled.",
            "when": {
              "setting": "combine_js",
              "value": true,
              "options": [
                {
                  "name": "autoptimize_js",
                  "value": "on"
                }
              ]
            }
          }
        ]
      },
      "a3-lazy-load/a3-lazy-load.php": {
        "settings_issues": [
          {
            "key": "enable_lazy_load",
            "severity": "warning",
            "code": "external_lazy_load_plugin_active",
            "message": "A3 Lazy Load is active. Avoid running two lazy-load layers unless you have tested the front end.",
            "when": {
              "setting": "enable_lazy_load",
              "value": true
            }
          }
        ]
      },
      "jetpack-boost/jetpack-boost.php": {
        "settings_issues": [
          {
            "key": "enable_lazy_load",
            "severity": "warning",
            "code": "external_lazy_load_plugin_active",
            "message": "Jetpack Boost is active. Avoid running two lazy-load layers unless you have tested the front end.",
            "when": {
              "setting": "enable_lazy_load",
              "value": true
            }
          }
        ]
      },
      "lazy-load/lazy-load.php": {
        "settings_issues": [
          {
            "key": "enable_lazy_load",
            "severity": "warning",
            "code": "external_lazy_load_plugin_active",
            "message": "Another lazy-load plugin is active. Avoid running two lazy-load layers unless you have tested the front end.",
            "when": {
              "setting": "enable_lazy_load",
              "value": true
            }
          }
        ]
      },
      "bj-lazy-load/bj-lazy-load.php": {
        "settings_issues": [
          {
            "key": "enable_lazy_load",
            "severity": "warning",
            "code": "external_lazy_load_plugin_active",
            "message": "BJ Lazy Load is active. Avoid running two lazy-load layers unless you have tested the front end.",
            "when": {
              "setting": "enable_lazy_load",
              "value": true
            }
          }
        ]
      },
      "litespeed-cache/litespeed-cache.php": {
        "settings_issues": [
          {
            "key": "enable_page_cache",
            "severity": "warning",
            "code": "external_page_cache_plugin_active",
            "message": "LiteSpeed Cache is active. Avoid running two full-page cache layers unless one of them is intentionally disabled.",
            "when": {
              "setting": "enable_page_cache",
              "value": true
            }
          }
        ]
      },
      "w3-total-cache/w3-total-cache.php": {
        "settings_issues": [
          {
            "key": "enable_page_cache",
            "severity": "warning",
            "code": "external_page_cache_plugin_active",
            "message": "W3 Total Cache is active. Avoid running two full-page cache layers unless one of them is intentionally disabled.",
            "when": {
              "setting": "enable_page_cache",
              "value": true
            }
          }
        ]
      },
      "wp-super-cache/wp-cache.php": {
        "settings_issues": [
          {
            "key": "enable_page_cache",
            "severity": "warning",
            "code": "external_page_cache_plugin_active",
            "message": "WP Super Cache is active. Avoid running two full-page cache layers unless one of them is intentionally disabled.",
            "when": {
              "setting": "enable_page_cache",
              "value": true
            }
          }
        ]
      },
      "wp-fastest-cache/wpFastestCache.php": {
        "settings_issues": [
          {
            "key": "enable_page_cache",
            "severity": "warning",
            "code": "external_page_cache_plugin_active",
            "message": "WP Fastest Cache is active. Avoid running two full-page cache layers unless one of them is intentionally disabled.",
            "when": {
              "setting": "enable_page_cache",
              "value": true
            }
          }
        ]
      },
      "sg-cachepress/sg-cachepress.php": {
        "settings_issues": [
          {
            "key": "enable_page_cache",
            "severity": "warning",
            "code": "external_page_cache_plugin_active",
            "message": "SiteGround Optimizer cache is active. Avoid running two full-page cache layers unless one of them is intentionally disabled.",
            "when": {
              "setting": "enable_page_cache",
              "value": true
            }
          }
        ]
      },
      "breeze/breeze.php": {
        "settings_issues": [
          {
            "key": "enable_page_cache",
            "severity": "warning",
            "code": "external_page_cache_plugin_active",
            "message": "Breeze cache is active. Avoid running two full-page cache layers unless one of them is intentionally disabled.",
            "when": {
              "setting": "enable_page_cache",
              "value": true
            }
          }
        ]
      }
    }
  }
}
